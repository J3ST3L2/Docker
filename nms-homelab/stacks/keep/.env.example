# Dockge target host
KEEP_BIND_IP=10.20.60.15

# Host ports
# 3100 is used by Loki on the NMS host.
KEEP_UI_PORT=3200
KEEP_API_PORT=8180
KEEP_WS_PORT=6101

# Initial local Keep login
KEEP_DEFAULT_USERNAME=tberno
KEEP_DEFAULT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Shared auth secret used by Keep frontend/backend.
# Generate with: openssl rand -hex 32
KEEP_AUTH_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_VALUE
